// Host adapter template. The installer discovers the draft-store chunk and export alias in the target client and
// renders this file as host.mjs; nothing here is pinned to a T3 release.
import * as chunk from '../@@CHUNK@@';

const drafts = chunk['@@ALIAS@@'];
const UNSUPPORTED = 'This T3 release changed its draft store, so dictation cannot write to the prompt. Update the Codex Dictation addon.';

function state() {
  try { return drafts?.getState?.() ?? null; } catch { return null; }
}

export function routeTarget(location) {
  const path = location.hash?.startsWith('#/') ? location.hash.slice(1) : location.pathname;
  let parts;
  try { parts = path.split('?')[0].split('/').filter(Boolean).map(decodeURIComponent); }
  catch { return null; }
  if (parts.length !== 2) return null;
  if (parts[0] === 'draft') return parts[1];
  return ['settings', 'onboarding'].includes(parts[0]) ? null : { environmentId: parts[0], threadId: parts[1] };
}

export const host = {
  unsupported() {
    const s = state();
    return typeof s?.getComposerDraft === 'function' && typeof s?.setPrompt === 'function' ? '' : UNSUPPORTED;
  },
  target: () => routeTarget(window.location),
  prompt(target) { return state()?.getComposerDraft(target)?.prompt ?? ''; },
  write(target, text) {
    if (host.unsupported()) throw new Error(UNSUPPORTED);
    state().setPrompt(target, text);
  },
  focus() {
    const input = [...document.querySelectorAll('[data-chat-composer-form="true"] textarea, [data-chat-composer-form="true"] [role="textbox"], [data-chat-composer-form="true"] [contenteditable="true"]')].find(e => e.getClientRects().length);
    input?.focus({ preventScroll: true });
    if (input?.setSelectionRange) input.setSelectionRange(input.value.length, input.value.length);
  },
};
