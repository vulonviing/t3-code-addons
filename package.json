{
  "name": "t3-code-addons",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "npm --prefix addons/model-council ci",
    "test": "npm --prefix addons/model-council test",
    "check": "python3 addons/model-council/scripts/install.py check",
    "inject": "python3 addons/model-council/scripts/install.py apply",
